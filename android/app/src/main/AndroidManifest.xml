<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Erinnerungen. In einer WebView gibt es weder Push noch die
         Notification-Schnittstelle des Browsers, also stellt Android
         die Wecker selbst. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Damit eine Erinnerung zur gedachten Minute kommt und nicht
         irgendwann, wenn das System gerade Lust hat. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Nach einem Neustart sind alle Alarme des Systems weg und muessen
         neu gestellt werden, sonst herrscht ab dann Stille. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/PlanerTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Damit die Rueckkehr von der Google-Anmeldung in dieser App
              landet und nicht im Browser. autoVerify prueft beim
              Installieren die assetlinks.json an der Wurzel der Domain -
              deshalb musste die Datei dort liegen.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="obamaslastname69.github.io"
                    android:pathPrefix="/Planer" />
            </intent-filter>

            <!--
              Eigenes Schema fuer die Rueckkehr von der Google-Anmeldung.
              Google antwortet auf eine gewoehnliche https-Adresse, und die
              bleibt im Browser haengen - ein fremder Browser reicht sie
              nicht an eine App weiter. Ein eigenes Schema dagegen reicht er
              weiter, also bringt die Seite das Token darueber zu uns.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="planer" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WeckerEmpfaenger"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.obamaslastname69.twa.WECKEN" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
